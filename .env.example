# Copy to your host's environment settings (never commit real values).
# Everything is optional; the defaults run fine locally.

# Server
PORT=4321
HOST=0.0.0.0
NODE_ENV=production
# Set to 1 only when a proxy/load balancer is in front (Fly, Render, nginx),
# so rate limits use the real client IP from X-Forwarded-For.
TRUST_PROXY=0
# Per-IP ceiling on API requests per minute.
API_RATE_PER_MIN=600

# Storage: folder for db.json, predictions.json, bets.json. Use a persistent disk.
DATA_DIR=./data

# Prediction Leagues
PL_SYNC_MS=120000
ESPN_WIN_PROB=on

# Bets: real sportsbook linking (SharpSports). Leave empty to use the Demo Book only.
SHARPSPORTS_PUBLIC_KEY=
SHARPSPORTS_PRIVATE_KEY=
